---
import {
  type GitHubContributor,
  getGitHubAvatarUrl,
  getGitHubProfileUrl,
} from "../libs/github";
import { type FormatLink, getContributorLink } from "../libs/link";
import { getStyleVariables } from "../libs/style";

interface Props {
  contributors: GitHubContributor[];
  focusColor?: string | undefined;
  formatLink?: FormatLink | undefined;
}

const { contributors, focusColor, formatLink } = Astro.props;

const style = getStyleVariables({ "--avatar-focus-color": focusColor });
---

<div style={style}>
  <ul class="avatar-list">
    {contributors.map((contributor) => (
      <li>
        <a
          href={getContributorLink(
            contributor.login,
            getGitHubProfileUrl(contributor.login),
            formatLink
          )}
        >
          <img
            alt={contributor.login}
            title={contributor.login}
            width="3rem"
            height="3rem"
            src={getGitHubAvatarUrl(contributor.id)}
            loading="lazy"
          />
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .avatar-list {
    --avatar-size: 3rem;
    --avatar-overlap: -0.125em;
    --avatar-row-spacing: 0.125em;
    --avatar-outline-width: 1px;
    --avatar-outline-offset: 0.08em;

    --local-accent: var(--avatar-focus-color, var(--sl-color-accent, #3b82f6));

    display: flex;
    flex-wrap: wrap;
    list-style: none;
    padding: 0rem;
    font-size: var(--avatar-size);
  }

  .avatar-list li {
    position: relative;
    --avatar-row-margin: calc(
      var(--avatar-outline-offset) + var(--avatar-outline-width) +
        var(--avatar-row-spacing) / 2
    );
    margin: var(--avatar-row-margin) var(--avatar-overlap)
      var(--avatar-row-margin) 0;
  }

  .avatar-list li:has(:focus-visible) {
    z-index: 10;
    transform: scale(1.1);
  }

  .avatar-list img,
  .avatar-list a {
    display: block;
    border-radius: 50%;
    width: var(--avatar-size);
    height: var(--avatar-size);
    text-decoration: none;
    color: transparent;
  }

  .avatar-list img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: var(--local-accent);
    outline: 1px solid transparent;
  }

  .avatar-list a:focus-visible {
    outline: 2px solid var(--local-accent);
    outline-offset: var(--avatar-outline-offset);
  }
</style>
