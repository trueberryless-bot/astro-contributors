---
import { getGitHubContributors } from "../libs/github";
import type { FormatLink } from "../libs/link";

import FacePile from "./FacePile.astro";

interface Props {
  focusColor?: string;
  formatLink?: FormatLink;
  githubRepo?: `${string}/${string}`;
  ignore?: string[];
}

const {
  focusColor,
  formatLink,
  githubRepo = "withastro/docs",
  ignore,
} = Astro.props;

const contributors = await getGitHubContributors(githubRepo, ignore);
---

<FacePile {contributors} {focusColor} {formatLink} />
